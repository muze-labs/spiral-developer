@prefix sd: <https://muze.nl/ns/spiral-developer#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sd:ArtifactShape
    a sh:NodeShape ;
    sh:targetSubjectsOf dcterms:identifier ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path sd:repositoryPath ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] .

sd:ArtifactReferenceShape
    a sh:NodeShape ;
    sh:targetClass sd:ArtifactReference ;
    sh:property [
        sh:path sd:artifact ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path sd:gitCommit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^([0-9a-f]{40}|[0-9a-f]{64})$"
    ] .


sd:SourceShape
    a sh:NodeShape ;
    sh:targetClass sd:Source ;
    sh:property [
        sh:path sd:sourceAvailability ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( sd:Retained sd:Referenced sd:Unavailable )
    ] ;
    sh:property [
        sh:path sd:provenanceConfidence ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( sd:Explicit sd:Evidenced sd:Inferred sd:Unknown )
    ] .


sd:UnderstandingShape
    a sh:NodeShape ;
    sh:targetClass sd:Understanding ;
    sh:property [
        sh:path sd:interprets ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path sd:provenanceConfidence ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( sd:Explicit sd:Evidenced sd:Inferred sd:Unknown )
    ] .


sd:ImplementationShape
    a sh:NodeShape ;
    sh:targetClass sd:Implementation ;
    sh:property [
        sh:path sd:implementationChangeKind ;
        sh:maxCount 1 ;
        sh:in ( sd:BehaviorPreservingChange sd:SemanticChange sd:MixedChange sd:UnknownChange )
    ] ;
    sh:or (
        [
            # First governed version: no predecessor-transition metadata.
            sh:property [ sh:path sd:transforms ; sh:maxCount 0 ] ;
            sh:property [ sh:path sd:changeCausedBy ; sh:maxCount 0 ] ;
            sh:property [ sh:path sd:implementationChangeKind ; sh:maxCount 0 ]
        ]
        [
            # Prospective/reliably explained revision.
            sh:property [ sh:path sd:transforms ; sh:minCount 1 ; sh:class sd:ArtifactReference ] ;
            sh:property [ sh:path sd:changeCausedBy ; sh:minCount 1 ; sh:class sd:ArtifactReference ] ;
            sh:property [
                sh:path sd:implementationChangeKind ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in ( sd:BehaviorPreservingChange sd:SemanticChange sd:MixedChange )
            ]
        ]
        [
            # Reconstructed lineage may know the predecessor while the transition semantics/cause remain unknown.
            sh:property [ sh:path sd:transforms ; sh:minCount 1 ; sh:class sd:ArtifactReference ] ;
            sh:property [ sh:path sd:changeCausedBy ; sh:maxCount 0 ] ;
            sh:property [
                sh:path sd:implementationChangeKind ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue sd:UnknownChange
            ]
        ]
    ) .


sd:VerificationEvidenceShape
    a sh:NodeShape ;
    sh:targetClass sd:VerificationEvidence ;
    sh:property [
        sh:path sd:verifies ;
        sh:minCount 1
    ] .

sd:AcceptanceEvidenceShape
    a sh:NodeShape ;
    sh:targetClass sd:AcceptanceEvidence ;
    sh:property [
        sh:path sd:accepts ;
        sh:minCount 1
    ] .
