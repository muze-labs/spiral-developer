@prefix sd: <https://muze.nl/ns/spiral-developer#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix project: <urn:spiral:replace-with-project-namespace:> .

# Save beside `.spiral/lessons/LES-YYYYMMDD-WORKSPACE-N.md`.
# Add sd:derivedFrom/sd:observes references to exact evidence versions when available.

project:LES-YYYYMMDD-WORKSPACE-N
    a sd:Lesson ;
    dcterms:identifier "LES-YYYYMMDD-WORKSPACE-N" ;
    sd:repositoryPath ".spiral/lessons/LES-YYYYMMDD-WORKSPACE-N.md" ;
    sd:status sd:Active .
