@prefix sd: <https://muze.nl/ns/spiral-developer#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix project: <urn:spiral:replace-with-project-namespace:> .

# Copy next to the corresponding human-facing artifact, for example:
# `.spiral/designs/DES-YYYYMMDD-WORKSPACE-N.ttl` beside `.spiral/designs/DES-YYYYMMDD-WORKSPACE-N.md`.
# Replace the class, ID, path, and causal relations. Source artifacts also declare `sd:sourceAvailability`; Understanding artifacts commonly use `sd:interprets`; Requests commonly `sd:derivedFrom` a material Understanding. Designs/implementations may use `sd:shapedBy` for material cultural influence, and ProjectContext may use `sd:adoptsCulture` for active profiles. Revised Implementation artifacts may also use `sd:implementationLocation`, `sd:transforms`, `sd:changeCausedBy`, and `sd:implementationChangeKind`; see docs/implementation-lineage.md.

project:DES-YYYYMMDD-WORKSPACE-N
    a sd:Design ;
    dcterms:identifier "DES-YYYYMMDD-WORKSPACE-N" ;
    sd:repositoryPath ".spiral/designs/DES-YYYYMMDD-WORKSPACE-N.md" ;
    sd:status sd:Active ;
    sd:satisfies [
        a sd:ArtifactReference ;
        sd:artifact project:REQ-YYYYMMDD-WORKSPACE-N ;
        sd:gitCommit "1111111111111111111111111111111111111111" ;
        sd:fragment "outcome-1"
    ] .
