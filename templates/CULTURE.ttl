@prefix sd: <https://muze.nl/ns/spiral-developer#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix project: <urn:spiral:replace-with-project-namespace:> .

# Save as `.spiral/culture.ttl` and use the same project namespace as project.ttl.

project:CUL-YYYYMMDD-WORKSPACE-N
    a sd:Culture ;
    dcterms:identifier "CUL-YYYYMMDD-WORKSPACE-N" ;
    sd:repositoryPath ".spiral/culture.md" ;
    sd:status sd:Active .
