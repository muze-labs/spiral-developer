@prefix sd: <https://muze.nl/ns/spiral-developer#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix project: <urn:spiral:replace-with-stable-project-namespace:> .

# Save as `.spiral/project.ttl`.
# Replace `project:` with a stable project namespace before real use.
# Prefer a durable HTTP(S) IRI when one naturally exists.

project:CTX-YYYYMMDD-WORKSPACE-N
    a sd:ProjectContext ;
    dcterms:identifier "CTX-YYYYMMDD-WORKSPACE-N" ;
    sd:repositoryPath ".spiral/project-context.md" ;
    sd:status sd:Active .

# When a versioned local/pinned culture profile is intentionally active, add for example:
#
#    sd:adoptsCulture [
#        a sd:ArtifactReference ;
#        sd:artifact project:CUL-YYYYMMDD-WORKSPACE-N ;
#        sd:gitCommit "FULL_COMMIT_HASH"
#    ] .

