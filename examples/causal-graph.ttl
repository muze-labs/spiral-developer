@prefix sd: <https://muze.nl/ns/spiral-developer#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix project: <https://example.org/projects/widget/spiral/> .

project:REQ-001
    a sd:Request ;
    dcterms:identifier "REQ-001" ;
    sd:repositoryPath ".spiral/requests/REQ-001.md" ;
    sd:status sd:Accepted .

project:DES-001
    a sd:Design ;
    dcterms:identifier "DES-001" ;
    sd:repositoryPath ".spiral/designs/DES-001.md" ;
    sd:status sd:Accepted ;
    sd:satisfies [
        a sd:ArtifactReference ;
        sd:artifact project:REQ-001 ;
        sd:gitCommit "1111111111111111111111111111111111111111" ;
        sd:fragment "outcome-1"
    ] .

project:IMP-001
    a sd:Implementation ;
    dcterms:identifier "IMP-001" ;
    sd:repositoryPath "src/account/deactivate.js" ;
    sd:status sd:Active ;
    sd:implements [
        a sd:ArtifactReference ;
        sd:artifact project:DES-001 ;
        sd:gitCommit "2222222222222222222222222222222222222222"
    ] .

project:EVD-001
    a sd:VerificationEvidence ;
    dcterms:identifier "EVD-001" ;
    sd:repositoryPath ".spiral/evidence/EVD-001.md" ;
    sd:status sd:Accepted ;
    sd:verifies [
        a sd:ArtifactReference ;
        sd:artifact project:IMP-001 ;
        sd:gitCommit "3333333333333333333333333333333333333333"
    ] .

project:ACC-001
    a sd:AcceptanceEvidence ;
    dcterms:identifier "ACC-001" ;
    sd:repositoryPath ".spiral/acceptance/ACC-001.md" ;
    sd:status sd:Accepted ;
    sd:accepts [
        a sd:ArtifactReference ;
        sd:artifact project:REQ-001 ;
        sd:gitCommit "1111111111111111111111111111111111111111" ;
        sd:fragment "outcome-1"
    ] ;
    sd:derivedFrom [
        a sd:ArtifactReference ;
        sd:artifact project:EVD-001 ;
        sd:gitCommit "4444444444444444444444444444444444444444"
    ] .
